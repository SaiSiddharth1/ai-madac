# ============================================
# AI MADAC - Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://madac_user:madac_password@localhost:5432/ai_madac
DATABASE_URL_SYNC=postgresql://madac_user:madac_password@localhost:5432/ai_madac

# --- Authentication ---
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Configuration ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key
# GOOGLE_API_KEY=your-google-key
# ANTHROPIC_API_KEY=your-anthropic-key

# --- Embeddings (for RAG - Future) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- App Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
CHARTS_DIR=./charts
MODELS_DIR=./models

# --- Observability (Optional) ---
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-madac
LOG_LEVEL=INFO
